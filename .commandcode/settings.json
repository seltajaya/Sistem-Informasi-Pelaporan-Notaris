{
  "permissions": {
    "allow": [
      "Shell(if:*)",
      "Shell(else:*)",
      "Shell(php -v)",
      "Shell(php artisan --version)",
      "Shell(dir node_modules /b 2>nul | findstr /c:\".package-lock.json\" >nul && (echo NODE_OK) || (echo NODE_MISSING) & dir public\\build\\manifest.json 2>nul >nul && (echo BUILD_OK) || (echo BUILD_MISSING))",
      "Shell(php artisan migrate:status)",
      "Shell(php artisan tinker --execute=\"echo 'Users: ' . \\App\\Models\\User::count() . PHP_EOL . 'Regions: ' . \\App\\Models\\Region::count() . PHP_EOL . 'Reports: ' . \\App\\Models\\Report::count() . PHP_EOL;\")",
      "Shell(php artisan serve --host=127.0.0.1 --port=8080)",
      "Shell(curl -s -o /dev/null -w welcome: %%{http_code}\\n http://127.0.0.1:8080/)",
      "Shell(curl -s -o /dev/null -w login: %%{http_code}\\n http://127.0.0.1:8080/login/simakuteng)",
      "powershell",
      "Shell(php artisan test --filter=\"RegionLoginTest|AdminScopeTest\")",
      "Shell(git:*)",
      "Shell(php artisan test --filter=RegionLoginTest 2 >& 1)",
      "Shell(php artisan test --filter=RegionLoginTest 2>&1)",
      "Shell(php artisan test 2>&1)",
      "Shell(vendorbinphpunit:*)",
      "Shell(php artisan tinker --execute=\"var_dump(app()->runningInConsole(), app()->runningUnitTests());\")",
      "Shell(composer:*)",
      "Shell(findstr:*)",
      "Shell(dir .env.testing 2>nul && echo EXISTS || echo NO_ENV_TESTING)",
      "Shell(del:*)",
      "Shell(reg query \"HKCU\\Environment\" /v APP_ENV 2>nul & echo --- & reg query \"HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Environment\" /v APP_ENV 2>nul)",
      "Shell(php artisan tinker --execute=\"var_dump(app()->environment());\")",
      "Shell(php -r \"var_dump(getenv('APP_ENV'), \\$_SERVER['APP_ENV'] ?? 'NOTSET', \\$_ENV['APP_ENV'] ?? 'NOTSET');\")",
      "Shell(php -r \"var_dump(getenv('APP_ENV')); var_dump(isset($_SERVER['APP_ENV']) ? $_SERVER['APP_ENV'] : 'NOTSET'); var_dump(isset($_ENV['APP_ENV']) ? $_ENV['APP_ENV'] : 'NOTSET');\")",
      "Shell(curl -s -o NUL -w \"%%{http_code}\" -c cookies.txt -b cookies.txt -d \"email=adm.simakuteng@example.com&password=admin123\" http://127.0.0.1:8080/login/simakuteng)",
      "Shell(php artisan route:list 2>&1)",
      "Shell(netstat:*)",
      "Shell(tasklist:*)",
      "Shell(curl -s -o NUL -w %%{http_code} http://127.0.0.1:8080/)",
      "Shell(echo.:*)",
      "Shell(curl -s -o NUL -w %%{http_code} http://127.0.0.1:8080/login)",
      "Shell(curl -s -o NUL -w %%{http_code} http://127.0.0.1:8080/login/simakuteng)",
      "Shell(curl -s -o NUL -w login plain: %%{http_code} http://127.0.0.1:8080/login)",
      "Shell(curl -s -o NUL -w login slug: %%{http_code} http://127.0.0.1:8080/login/simakuteng)",
      "Shell(curl -s -o NUL -w login admin: %%{http_code} http://127.0.0.1:8080/admin/login)",
      "Shell(php artisan route:clear)",
      "Shell(php artisan config:clear)",
      "Shell(php artisan cache:clear)",
      "Shell(php artisan view:clear)"
    ],
    "deny": [],
    "defaultMode": "default"
  }
}